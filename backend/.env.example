# Sarvam AI API Key (Get yours from https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_key_here

# Layer 2: Sarvam Speech-to-Text Model & Parameters
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_TIMEOUT=15.0
MAX_AUDIO_SIZE_MB=10
MAX_AUDIO_DURATION_SECONDS=30.0

# Optional: Gemini API Key for Layer 4 AI Reasoning
GEMINI_API_KEY=your_gemini_key_here

# Layer 7: Supabase Database, Realtime, & Storage
# NEVER expose SUPABASE_SERVICE_KEY to the frontend client!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
